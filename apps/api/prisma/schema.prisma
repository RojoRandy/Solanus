// Comedor Solanus — schema de base de datos
// Punto de sincronización único: no editar en paralelo (ver docs del plan, sección 3.1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Sistema y personas
// ─────────────────────────────────────────────────────────────

enum RolUsuario {
  ADMINISTRADOR
  USUARIO
  USUARIO_SIMPLE
}

model Usuario {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  password  String
  nombre    String
  rol       RolUsuario
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  turnosRegistrados      TurnoComida[]         @relation("TurnoRegistradoPor")
  asistenciasRegistradas Asistencia[]          @relation("AsistenciaRegistradaPor")
  movimientosRegistrados MovimientoInventario[] @relation("MovimientoRegistradoPor")
  movimientosEditados    MovimientoInventario[] @relation("MovimientoEditadoPor")

  @@map("usuarios")
}

model Comensal {
  id              Int       @id @default(autoincrement())
  folio           Int       @unique @default(autoincrement())
  nombres         String
  apellidos       String
  fechaNacimiento DateTime
  curp            String?
  ineFrontPath    String?
  ineBackPath     String?
  fotoPath        String?
  tutorId         Int?
  tutor           Comensal? @relation("TutorMenores", fields: [tutorId], references: [id])
  menores         Comensal[] @relation("TutorMenores")
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cartaUsoImagen CartaUsoImagen?
  asistencias    Asistencia[]

  @@index([apellidos, nombres])
  @@map("comensales")
}

model CartaUsoImagen {
  id           Int       @id @default(autoincrement())
  comensalId   Int       @unique
  comensal     Comensal  @relation(fields: [comensalId], references: [id])
  // Quien firma: el propio comensal si es mayor de edad, o su tutor si es menor.
  firmanteId   Int?
  autoriza     Boolean   @default(false)
  fechaFirma   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("cartas_uso_imagen")
}

model Voluntario {
  id        Int      @id @default(autoincrement())
  nombres   String
  apellidos String
  telefono  String
  fotoPath  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turnos TurnoVoluntario[]

  @@index([apellidos, nombres])
  @@map("voluntarios")
}

model Bienhechor {
  id        Int      @id @default(autoincrement())
  nombre    String
  contacto  String?
  rfc       String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lotes LoteInventario[]

  @@map("bienhechores")
}

// ─────────────────────────────────────────────────────────────
// Turno de comida — sustituye la hoja de papel diaria
// ─────────────────────────────────────────────────────────────

enum HorarioComida {
  DESAYUNO
  COMIDA
  CENA
}

model TurnoComida {
  id              Int           @id @default(autoincrement())
  fecha           DateTime      @db.Date
  horario         HorarioComida
  menu            String?
  notas           String?
  registradoPorId Int
  registradoPor   Usuario       @relation("TurnoRegistradoPor", fields: [registradoPorId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  asistencias  Asistencia[]
  voluntarios  TurnoVoluntario[]
  movimientos  MovimientoInventario[]

  @@unique([fecha, horario])
  @@map("turnos_comida")
}

model TurnoVoluntario {
  id           Int        @id @default(autoincrement())
  turnoId      Int
  turno        TurnoComida @relation(fields: [turnoId], references: [id])
  voluntarioId Int
  voluntario   Voluntario  @relation(fields: [voluntarioId], references: [id])
  createdAt    DateTime    @default(now())

  @@unique([turnoId, voluntarioId])
  @@map("turno_voluntarios")
}

enum MetodoCaptura {
  FOLIO
  NOMBRE
  QR
  FACIAL
}

model Asistencia {
  id              Int           @id @default(autoincrement())
  comensalId      Int
  comensal        Comensal      @relation(fields: [comensalId], references: [id])
  turnoId         Int
  turno           TurnoComida   @relation(fields: [turnoId], references: [id])
  metodoCaptura   MetodoCaptura @default(FOLIO)
  registradoPorId Int
  registradoPor   Usuario       @relation("AsistenciaRegistradaPor", fields: [registradoPorId], references: [id])
  createdAt       DateTime      @default(now())

  @@unique([comensalId, turnoId])
  @@map("asistencias")
}

// ─────────────────────────────────────────────────────────────
// Inventario
// ─────────────────────────────────────────────────────────────

model CategoriaInventario {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  productos Producto[]

  @@map("categorias_inventario")
}

model UnidadMedida {
  id      Int     @id @default(autoincrement())
  nombre  String  @unique
  abrevia String  @unique
  activo  Boolean @default(true)

  variantes VarianteInventario[]

  @@map("unidades_medida")
}

// El producto es solo qué cosa es: nombre y categoría. Marca, presentación,
// ubicación y unidad de medida cambian en cada compra o donación, así que
// viven en el lote (ver LoteInventario), no aquí.
model Producto {
  id           Int                 @id @default(autoincrement())
  nombre       String
  codigoBarras String?
  categoriaId  Int
  categoria    CategoriaInventario @relation(fields: [categoriaId], references: [id])
  activo       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  variantes VarianteInventario[]

  @@unique([nombre, categoriaId])
  @@index([nombre])
  @@map("productos")
}

enum EstadoProducto {
  CRUDO
  COCIDO
}

// Una variante es la combinación real que se cuenta en el almacén:
// "Frijol · kg · crudo" y "Frijol · pieza · cocido" son existencias distintas
// y no se descuentan entre sí. Es también donde se configura el stock mínimo.
model VarianteInventario {
  id          Int            @id @default(autoincrement())
  productoId  Int
  producto    Producto       @relation(fields: [productoId], references: [id])
  unidadId    Int
  unidad      UnidadMedida   @relation(fields: [unidadId], references: [id])
  estado      EstadoProducto
  stockMinimo Decimal        @default(0) @db.Decimal(12, 3)
  activo      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lotes       LoteInventario[]
  movimientos MovimientoInventario[]

  @@unique([productoId, unidadId, estado])
  @@index([productoId])
  @@map("variantes_inventario")
}

enum OrigenLote {
  COMPRADO
  DONADO
}

model LoteInventario {
  id                 Int                @id @default(autoincrement())
  varianteId         Int
  variante           VarianteInventario @relation(fields: [varianteId], references: [id])
  marca              String?
  presentacion       String?
  ubicacion          String?
  cantidadInicial    Decimal            @db.Decimal(12, 3)
  cantidadDisponible Decimal            @db.Decimal(12, 3)
  fechaCaducidad     DateTime?          @db.Date
  fechaIngreso       DateTime           @db.Date
  costoUnitario      Decimal?           @db.Decimal(12, 2)
  costoTotal         Decimal?           @db.Decimal(12, 2)
  origen             OrigenLote
  bienhechorId       Int?
  bienhechor         Bienhechor?        @relation(fields: [bienhechorId], references: [id])
  cfdi               String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  movimientos MovimientoInventario[]

  // FEFO: primero lo que caduca antes, dentro de la misma variante.
  @@index([varianteId, fechaCaducidad])
  @@index([origen, fechaIngreso])
  @@map("lotes_inventario")
}

// Catálogo abierto de motivos: permite agregar "despensa" en fase futura sin rediseñar el modelo.
// `clave` es lo que consulta el código (el nombre es editable desde Configuración);
// `esMerma` marca los motivos que cuentan como merma en el reporte de inventario.
model MotivoMovimiento {
  id        Int     @id @default(autoincrement())
  clave     String  @unique
  nombre    String  @unique
  esMerma   Boolean @default(false)
  esSistema Boolean @default(false)
  activo    Boolean @default(true)

  movimientos MovimientoInventario[]

  @@map("motivos_movimiento")
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

model MovimientoInventario {
  id              Int                @id @default(autoincrement())
  varianteId      Int
  variante        VarianteInventario @relation(fields: [varianteId], references: [id])
  loteId          Int?
  lote            LoteInventario?    @relation(fields: [loteId], references: [id])
  tipo            TipoMovimiento
  motivoId        Int
  motivo          MotivoMovimiento   @relation(fields: [motivoId], references: [id])
  // Positiva en ENTRADA y SALIDA; en AJUSTE lleva signo (delta sobre la existencia).
  cantidad        Decimal            @db.Decimal(12, 3)
  turnoId         Int?
  turno           TurnoComida?       @relation(fields: [turnoId], references: [id])
  registradoPorId Int
  registradoPor   Usuario            @relation("MovimientoRegistradoPor", fields: [registradoPorId], references: [id])
  // Solo se pueden editar fecha, motivo y notas; la cantidad se corrige con un AJUSTE.
  editadoPorId    Int?
  editadoPor      Usuario?           @relation("MovimientoEditadoPor", fields: [editadoPorId], references: [id])
  fecha           DateTime           @default(now())
  actualizadoEn   DateTime           @updatedAt
  notas           String?

  @@index([varianteId, fecha])
  @@index([fecha])
  @@map("movimientos_inventario")
}
