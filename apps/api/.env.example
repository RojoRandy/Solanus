# Base de datos (ver docker-compose.yml en la raíz del repo)
DATABASE_URL="postgresql://comedor:comedor@localhost:5442/comedor_solanus?schema=public"

# JWT
JWT_SECRET="cambia-este-valor-en-produccion"
JWT_EXPIRATION="8h"
JWT_REFRESH_SECRET="cambia-este-otro-valor-en-produccion"
JWT_REFRESH_EXPIRATION="30d"

# Servidor
PORT=3210
# Orígenes permitidos para CORS, separados por coma (vacío = cualquiera, solo para dev)
WEB_ORIGIN=
# "true" para exponer /api/docs (Swagger) — dejar apagado en producción
SWAGGER_ENABLED=false

# Almacenamiento de archivos (fotos, INE, PDFs de expediente)
# STORAGE_DRIVER=local escribe en disco (dev); STORAGE_DRIVER=s3 usa el bucket de abajo (producción)
STORAGE_DRIVER="local"
UPLOADS_DIR="./uploads"
UPLOADS_PUBLIC_PATH="/uploads"

# Solo si STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_URL_TTL=900
