# Base de datos (ver docker-compose.yml en la raíz del repo)
DATABASE_URL="postgresql://comedor:comedor@localhost:5442/comedor_solanus?schema=public"

# JWT
JWT_SECRET="cambia-este-valor-en-produccion"
JWT_EXPIRATION="8h"
JWT_REFRESH_SECRET="cambia-este-otro-valor-en-produccion"
