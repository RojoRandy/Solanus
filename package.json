{
  "name": "comedor-solanus",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gesti\u00f3n interna del Comedor Comunitario Beato Solanus Casey (Amigos de los Capuchinos ABP)",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --recursive --filter ./apps/* build",
    "lint": "pnpm --recursive --filter ./apps/* lint",
    "test": "pnpm --recursive --filter ./apps/* test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "bcrypt",
      "prisma",
      "puppeteer"
    ]
  }
}
